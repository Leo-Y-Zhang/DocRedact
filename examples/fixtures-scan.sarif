          "rules": [
            {
              "id": "api_key",
              "shortDescription": {
                "text": "api_key finding"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critical",
                "reference": "CWE-798 hardcoded credentials"
              }
            },
            {
              "id": "credit_card",
              "shortDescription": {
                "text": "credit_card finding"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "high",
                "reference": "CWE-312 cleartext storage of card data (PCI)"
              }
            },
            {
